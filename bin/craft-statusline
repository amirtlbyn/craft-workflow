#!/usr/bin/env python3
"""craft-statusline - Claude Code's status line, with the craft state and usage detail.

Claude Code runs it on every refresh with a JSON object on stdin (the model, the
context window, the 5-hour and 7-day rate limits, the session cost) and draws
what it prints. The craft state comes from bin/craft-ui-state, which only reads.

    🛠 Opus · high · ⎇ main │ craft task · CSL ✓ approved · A trace ✓ tests ✗ · B ○ · 3/7
    🧠 ctx ███▎···· 42% 84k/200k │ ⏱ 5h ██████▏┃·· 62% ↻1h10m pace 77% │ 📅 7d █▊·┃······ 18% ↻4d6h pace 39%
    💰 $1.23 · $2.11/h · 35m (api 12m) · +120 −8 · in 1.2M out 45k · cache 93%

The bar marker (┃) is where usage would be if it grew evenly over the window,
and "⚠ full in 40m" is added when the current rate reaches 100% before the
window resets.

Settings (Claude Code's settings.json):

    "statusLine": {"type": "command", "refreshInterval": 60,
                   "command": "python3 <plugin root>/bin/craft-statusline --detail"}

Usage:
    bin/craft-statusline [--theme=NAME] [--bar=STYLE] [--detail]   (JSON on stdin)
    bin/craft-statusline --preview [--bar=STYLE] [--detail]

Options (a flag wins over its environment variable):
    --theme=NAME   CRAFT_STATUSLINE_THEME     craft (default), minimal, neon, ocean, dracula, nord,
                                              catppuccin, gruvbox, tokyo-night, mono
    --bar=STYLE    CRAFT_STATUSLINE_BAR       gradient-pill, pill, gradient, blocks, smooth, dots,
                                              line, squares, braille, ascii (default: the theme's own)
    --detail       CRAFT_STATUSLINE_DETAIL=1  a third line: cost, rate, time, lines, tokens, cache
    --preview      print every theme and bar style on sample data
    NO_COLOR       no ANSI colour

An unknown theme or bar style falls back to the default. Exit code 0, always.
"""

import json
import math
import os
import pathlib
import subprocess
import sys
import time
from dataclasses import dataclass, field, replace
from datetime import datetime

PLUGIN_ROOT = pathlib.Path(__file__).resolve().parent.parent
UI_STATE = PLUGIN_ROOT / "bin" / "craft-ui-state"
UI_STATE_TIMEOUT_S = 3
GIT_TIMEOUT_S = 1

ESC = "\x1b["
RESET = ESC + "0m"

# (label, rate_limits key, window length in seconds)
WINDOWS = (("5h", "five_hour", 5 * 3600), ("7d", "seven_day", 7 * 86400))

# Bar styles: the filled cell and the empty cell. The smooth styles also draw
# eighths; a pill draws on the theme's background track; a gradient colours each
# filled cell by its place on the theme's ramp.
BARS = {
    "gradient-pill": ("█", " "),
    "pill": ("█", " "),
    "gradient": ("█", "░"),
    "blocks": ("█", "░"),
    "smooth": ("█", " "),
    "dots": ("●", "○"),
    "line": ("━", "─"),
    "squares": ("■", "□"),
    "braille": ("⣿", "⣀"),
    "ascii": ("#", "-"),
}
SMOOTH_STYLES = {"smooth", "pill", "gradient-pill"}
PILL_STYLES = {"pill", "gradient-pill"}
GRADIENT_STYLES = {"gradient", "gradient-pill"}
# Without colour a pill has no track, so its empty cells draw this rail.
PILL_RAIL = "·"
SMOOTH_EIGHTHS = " ▏▎▍▌▋▊▉"
WARN_PERCENT = 70
BAD_PERCENT = 90


@dataclass(frozen=True)
class Theme:
    name: str
    bar: str
    sep: str
    marker: str
    icons: dict = field(default_factory=dict)
    # 256-colour codes by role: accent, text, dim, ok, warn, bad. None: no colour.
    palette: dict | None = None
    # Colour a usage level only from WARN_PERCENT up.
    quiet_levels: bool = False
    # 256-colour codes from an empty bar's colour to a full one's, for gradients.
    ramp: tuple = ()
    # The 256-colour background a pill is drawn on.
    track: int | None = None


