#!/usr/bin/env python3
"""craft-sync-codex - generate the Codex CLI and ZCode mirrors of this plugin.

Claude Code discovers this plugin through skills/, commands/, agents/, and the
global CLAUDE.md. Codex CLI has no plugin system that reads those directly. It
discovers a skill at .agents/skills/<name>/SKILL.md, a subagent at
.codex/agents/<name>.toml, and repository guidance at AGENTS.md. This script
generates that mirror from the Claude-side source, so a developer edits one
side and never the other.

ZCode reads skills/, commands/, and hooks/ directly through
.zcode-plugin/plugin.json, but it resolves the Claude model aliases in
agents/*.md (sonnet, opus, haiku) to "no override" - the session default -
which would silently flatten the model tiering. So the script also generates
a ZCode subagent mirror at .zcode-plugin/agents/, identical to the source
except that model and thoughtLevel are pinned from ZCODE_AGENT_MODELS below.

    craft-sync-codex              report which generated files are missing or
                                   stale. Read-only. Exit 1 if any are
    craft-sync-codex --write      regenerate every Codex-side file
    craft-sync-codex --json       the report above, as JSON

What it generates, and from what:
    skills/<name>/SKILL.md        -> .agents/skills/<name>/SKILL.md
    commands/<name>.md            -> .agents/skills/<name>/SKILL.md
                                      (skipped when a skill of the same name
                                      already exists, e.g. commands/craft.md
                                      vs. skills/craft/ - the skill already is
                                      the full router)
    agents/<name>.md              -> .codex/agents/<name>.toml
    agents/<name>.md              -> .zcode-plugin/agents/<name>.md
                                     (model and thoughtLevel come from
                                     ZCODE_AGENT_MODELS below; an agent
                                     missing from that map inherits the
                                     session's default model)
    (this script's own AGENTS_MD_BODY constant) -> AGENTS.md

Every generated file opens with a comment naming its source. Hand-editing a
generated file is pointless: the next --write overwrites it, and --check
reports the edit as drift rather than accepting it.

What this script does not do: it does not generate .codex/hooks.json. Codex's
exact hook payload schema is not verifiable from documentation alone, and a
wrong guess would silently fail to enforce a gate rather than loudly refuse to
run. That is a separate, later piece of work, checked against a real Codex
session.

This script writes only under .agents/skills/, .codex/agents/,
.zcode-plugin/agents/, and AGENTS.md at the plugin root, and only when
--write is given. It never touches skills/, commands/, or agents/ - those
stay the single source of truth. Standard library only.
"""

import argparse
import json
import pathlib
import shutil
import sys

PLUGIN_ROOT = pathlib.Path(__file__).resolve().parent.parent
SKILLS_DIR = PLUGIN_ROOT / "skills"
COMMANDS_DIR = PLUGIN_ROOT / "commands"
AGENTS_SRC_DIR = PLUGIN_ROOT / "agents"
OUT_SKILLS_DIR = PLUGIN_ROOT / ".agents" / "skills"
OUT_AGENTS_DIR = PLUGIN_ROOT / ".codex" / "agents"
OUT_ZCODE_AGENTS_DIR = PLUGIN_ROOT / ".zcode-plugin" / "agents"
AGENTS_MD_PATH = PLUGIN_ROOT / "AGENTS.md"

RESOURCE_SUBDIRS = ("references", "examples", "scripts", "assets", "templates", "lenses")

# ZCode model routing for the .zcode-plugin/agents/ mirror: agent name ->
# (model id, thought level). The model ids name the provider account this
# plugin's author runs, so a reader on a different plan edits them here.
# Thought levels are the ones ZCode offers for these models: low, high, max.
#
# ZCode parses the Claude model aliases in agents/*.md (sonnet, opus, haiku)
# but resolves every one to "no override" - the session's default model - so
# without this map the tiered routing silently flattens. An agent missing
# from the map is generated without model or thoughtLevel and inherits the
# session default, the same policy the Codex mirror applies to every agent.
ZCODE_AGENT_MODELS = {
    "coder": ("account:zai-individual-coding-plan/GLM-5.3-Flash", "max"),
    "reviewer": ("account:zai-individual-coding-plan/GLM-5.3", "high"),
    "deep-reviewer": ("account:zai-individual-coding-plan/GLM-5.3", "max"),
}

GENERATED_MD_COMMENT = (
    "<!-- GENERATED by bin/craft-sync-codex from {source}. Do not hand-edit "
    "this file -- edit the source and run 'bin/craft-sync-codex --write'. -->"
)
GENERATED_TOML_COMMENT = (
    "# GENERATED by bin/craft-sync-codex from {source}. Do not hand-edit this\n"
    "# file -- edit the source and run 'bin/craft-sync-codex --write'."
)

AGENTS_MD_BODY = """\
# craft-workflow

This is the source of the craft-workflow plugin: a cost-routed engineering
workflow for Claude Code, Codex CLI, and ZCode. If you are an agent working
in this repository, you are working on the plugin itself, not using it on an
application.

## Where things live

- `skills/`, `commands/`, `agents/` are the Claude Code source. Codex reads
  the generated mirror instead: `.agents/skills/`, `.codex/agents/`.
- ZCode reads `skills/`, `commands/`, and `hooks/` directly through
  `.zcode-plugin/plugin.json`, and reads the generated mirror
  `.zcode-plugin/agents/` for its subagents, whose model ids come from
  `ZCODE_AGENT_MODELS` in `bin/craft-sync-codex`.
- `config/workflow.md` is the one file a plugin user edits to retarget the
  workflow. Do not change routing behavior anywhere else.
- `standards/` holds the vendored engineering standards every skill and
  reviewer reads.
- `hooks/` holds the Claude Code hooks this plugin enforces, not just
  requests: the spec gate, `*.human.md` protection, the component gate, the
  done/Gate-A check, and the session-start status. Codex CLI does not run them yet - see
  "Codex support" below.
- `hooks/mod/` is a Claude Code mod (`hooks/mod.json`, named by
  `.claude-plugin/plugin.json`): the status, the craft board, cost per agent.
  It enforces nothing. ZCode and Codex do not load it.
- `stacks/<id>/stack.json` are the stack packs (django, fastapi, go, java,
  node, laravel, symfony, php) that `bin/craft-stack` detects. `config/deciders.json` lists the AI
  deciders `bin/craft-decide` chooses from.

## Generated files - do not hand-edit

`.agents/skills/`, `.codex/agents/`, `.zcode-plugin/agents/`, and this file
(`AGENTS.md`) are generated by `bin/craft-sync-codex` from `skills/`,
`commands/`, and `agents/`. Edit the source directory, then run:

    bin/craft-sync-codex --write

Hand-editing a generated file is overwritten on the next `--write`, and
`bin/craft-sync-codex` (with no flag) reports the edit as drift.

## Codex support - what works today

Skills, commands, and subagents are available to Codex through the generated
mirror. The four hook-enforced gates - `*.human.md` protection, the spec
gate, the component gate, and the done/Gate-A verification at session end - run
only under Claude Code and ZCode today. The `bin/` commands (`craft-spec`,
`craft-approve`, `craft-check`, `craft-std`) work the same under every tool.
A Codex session can still follow the same workflow as prose, but nothing
blocks it from skipping a gate the way the Claude Code hooks do. Do not tell a developer these gates are enforced under Codex until
`.codex/hooks.json` ships.

## ZCode support - what works today

Skills, commands, and subagents are available to ZCode through
`.zcode-plugin/plugin.json`, and ZCode runs the same `hooks/hooks.json`
Claude Code does. Subagent models are pinned per agent by
`ZCODE_AGENT_MODELS` in `bin/craft-sync-codex`; an agent missing from that
map inherits the session default model.

## Ownership

Never edit a `*.human.md` file. Report the fragment and its location instead,
and let a human place it.
"""


class FrontmatterError(Exception):
    """The frontmatter block of a source file could not be read."""


# ---------------------------------------------------------------------------
# A small frontmatter reader
#
# Handles what this plugin's own files actually use: single-line "key:
# value" (quoted or bare), and YAML folded/literal block scalars ("key: >"
# or "key: |" followed by indented lines) for the two skills whose
# description is written across several lines. It does not attempt general
# YAML - a nested mapping such as SKILL.md's "metadata:" block is read and
# ignored, since no generator here needs it.
# ---------------------------------------------------------------------------


def unescape_double_quoted(inner):
    """Undo YAML double-quote escaping: \\" -> ", \\\\ -> \\. A left-to-right
    scan, not chained .replace() calls, so a backslash this step inserts is
    never mistaken for one already in the source."""
    result = []
    i = 0
    while i < len(inner):
        if inner[i] == "\\" and i + 1 < len(inner) and inner[i + 1] in ('"', "\\"):
            result.append(inner[i + 1])
            i += 2
            continue
        result.append(inner[i])
        i += 1
    return "".join(result)


def strip_quotes(value):
    value = value.strip()
    if len(value) < 2 or value[0] != value[-1] or value[0] not in "\"'":
        return value
    inner = value[1:-1]
    if value[0] == '"':
        return unescape_double_quoted(inner)
    return inner.replace("''", "'")


def parse_frontmatter(block):
    fields = {}
    lines = block.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        if not line.strip() or line[:1] in (" ", "\t"):
            # blank, or a continuation/nested line with no owning block
            # scalar above it (e.g. inside "metadata:"). Skip.
            i += 1
            continue
        if ":" not in line:
            i += 1
            continue
        key, _, rest = line.partition(":")
        key = key.strip()
        rest = rest.strip()
        if rest in (">", "|", ">-", "|-"):
            i += 1
            collected = []
            while i < len(lines) and (
                lines[i][:1] in (" ", "\t") or not lines[i].strip()
            ):
                collected.append(lines[i].strip())
                i += 1
            fields[key] = " ".join(part for part in collected if part)
            continue
        fields[key] = strip_quotes(rest)
        i += 1
    return fields


def read_frontmatter(path):
    """Return (frontmatter dict, body string) for a markdown file with a
    '---' delimited frontmatter block."""
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        raise FrontmatterError("%s: no frontmatter, file must start with ---" % path)
    end = text.find("\n---\n", 4)
    if end == -1:
        raise FrontmatterError("%s: frontmatter is never closed with ---" % path)
    block = text[4:end]
    body = text[end + 5 :]
    return parse_frontmatter(block), body.strip("\n")


# ---------------------------------------------------------------------------
# Renderers
# ---------------------------------------------------------------------------


def yaml_double_quote(text):
    escaped = text.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")
    return '"%s"' % escaped


def render_skill_md(name, description, body, source):
    header = GENERATED_MD_COMMENT.format(source=source)
    front = "---\nname: %s\ndescription: %s\n---\n" % (
        name,
        yaml_double_quote(description),
    )
    return "%s\n\n%s\n%s\n" % (header, front, body.strip())


def toml_basic_string(text):
    escaped = text.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
    return '"%s"' % escaped


def toml_multiline_string(text):
    # Backslash starts an escape sequence in a TOML multi-line basic string,
    # so it must be escaped first -- otherwise a body containing a regex
    # like "\d+" or a Windows path produces a file no TOML reader can parse.
    # A literal '"""' would close the block early, so it is escaped second,
    # using the backslash this second step inserts, which the first step has
    # already made safe.
    safe = text.replace("\\", "\\\\").replace('"""', '\\"\\"\\"')
    return '"""\n%s\n"""' % safe


def render_agent_toml(name, description, body, sandbox_mode, source):
    header = GENERATED_TOML_COMMENT.format(source=source)
    return (
        "%s\n\n"
        "name = %s\n"
        "description = %s\n"
        "sandbox_mode = %s\n"
        "\n"
        "# model is deliberately left unset. Claude Code model names\n"
        "# (haiku/sonnet/opus) and Codex model names do not correspond, and a\n"
        "# fabricated mapping would silently break whenever either vendor\n"
        "# renames a model. This agent inherits the operator's Codex session\n"
        "# default model instead.\n"
        "\n"
        "developer_instructions = %s\n"
        % (
            header,
            toml_basic_string(name),
            toml_basic_string(description),
            toml_basic_string(sandbox_mode),
            toml_multiline_string(body.strip()),
        )
    )


def render_agent_zcode_md(name, description, body, tools, model, thought_level, source):
    # ZCode's own bundled agents open their file with '---', and a leading
    # HTML comment before the frontmatter is proven for skills but not for
    # subagents. The provenance comment therefore sits between the
    # frontmatter and the body - still at the top of the file, just not
    # before the '---'.
    front = [
        "---",
        "name: %s" % name,
        "description: %s" % yaml_double_quote(description),
    ]
    if tools:
        front.append("tools: %s" % tools)
    if model:
        front.append("model: %s" % model)
    if thought_level:
        front.append("thoughtLevel: %s" % thought_level)
    front.append("---")
    header = GENERATED_MD_COMMENT.format(source=source)
    return "%s\n\n%s\n\n%s\n" % ("\n".join(front), header, body.strip())


# ---------------------------------------------------------------------------
# Planning - collect what should exist, without touching disk
# ---------------------------------------------------------------------------


class Plan:
    """What craft-sync-codex would write: a map of path -> desired bytes,
    plus a list of (source directory, destination directory) resource copies,
    plus any error found while planning."""

    def __init__(self):
        self.files = {}  # pathlib.Path -> str
        self.sources = {}  # pathlib.Path -> the source label that planned it
        self.directory_copies = []  # (src, dst)
        self.errors = []  # (label, message)
        # An agent source that fails to parse can still name itself (a bare
        # missing 'description' leaves 'name' readable) or not (a missing
        # frontmatter block leaves nothing to read). Orphan detection for
        # agents/*.md needs both, since its generated file name comes from
        # the frontmatter 'name' field, not the source file's own name.
        self.broken_agent_names = set()
        self.has_unresolvable_broken_agent = False

    def write(self, path, content, source=""):
        if path in self.files:
            self.fail(
                source or str(path),
                "would overwrite %s, already planned from %s -- two sources "
                "produced the same output name" % (path, self.sources.get(path, "?")),
            )
            return
        self.files[path] = content
        self.sources[path] = source

    def copy_dir(self, src, dst):
        self.directory_copies.append((src, dst))

    def fail(self, label, message):
        self.errors.append((label, message))


def plan_skills(plan):
    if not SKILLS_DIR.is_dir():
        return
    for skill_dir in sorted(p for p in SKILLS_DIR.iterdir() if p.is_dir()):
        skill_md = skill_dir / "SKILL.md"
        if not skill_md.is_file():
            continue
        try:
            front, body = read_frontmatter(skill_md)
        except FrontmatterError as error:
            plan.fail(str(skill_md), str(error))
            continue
        name = front.get("name", skill_dir.name)
        description = front.get("description", "")
        if not description:
            plan.fail(str(skill_md), "missing required frontmatter field 'description'")
            continue
        out_dir = OUT_SKILLS_DIR / skill_dir.name
        source = "skills/%s/SKILL.md" % skill_dir.name
        content = render_skill_md(name, description, body, source=source)
        plan.write(out_dir / "SKILL.md", content, source=source)
        for extra in RESOURCE_SUBDIRS:
            src = skill_dir / extra
            if src.is_dir():
                plan.copy_dir(src, out_dir / extra)


def existing_skill_names():
    if not SKILLS_DIR.is_dir():
        return set()
    return {
        p.name
        for p in SKILLS_DIR.iterdir()
        if p.is_dir() and (p / "SKILL.md").is_file()
    }


def plan_commands(plan, skill_names):
    if not COMMANDS_DIR.is_dir():
        return
    for command_md in sorted(COMMANDS_DIR.glob("*.md")):
        name = command_md.stem
        if name in skill_names:
            # A skill of this name already exists and is already the full
            # router (e.g. commands/craft.md vs. skills/craft/). Generating
            # a second entry would collide and duplicate content that says
            # the same thing twice.
            continue
        try:
            front, body = read_frontmatter(command_md)
        except FrontmatterError as error:
            plan.fail(str(command_md), str(error))
            continue
        description = front.get("description", "")
        if not description:
            plan.fail(
                str(command_md), "missing required frontmatter field 'description'"
            )
            continue
        argument_hint = front.get("argument-hint", "")
        if argument_hint:
            description = "%s. Arguments: %s." % (
                description.rstrip("."),
                argument_hint,
            )
        invocation = "Invoke explicitly: `$%s%s`.\n\n" % (
            name,
            (" " + argument_hint) if argument_hint else "",
        )
        source = "commands/%s.md" % name
        content = render_skill_md(
            name, description, invocation + body.strip(), source=source
        )
        plan.write(OUT_SKILLS_DIR / name / "SKILL.md", content, source=source)


def plan_agents(plan):
    if not AGENTS_SRC_DIR.is_dir():
        return
    for agent_md in sorted(AGENTS_SRC_DIR.glob("*.md")):
        try:
            front, body = read_frontmatter(agent_md)
        except FrontmatterError as error:
            plan.fail(str(agent_md), str(error))
            plan.has_unresolvable_broken_agent = True
            continue
        name = front.get("name")
        description = front.get("description")
        if not name or not description:
            plan.fail(
                str(agent_md),
                "missing required frontmatter field 'name' or 'description'",
            )
            if name:
                plan.broken_agent_names.add(name)
            else:
                plan.has_unresolvable_broken_agent = True
            continue
        tools = [
            token.strip()
            for token in front.get("tools", "").split(",")
            if token.strip()
        ]
        sandbox_mode = (
            "workspace-write" if ("Edit" in tools or "Write" in tools) else "read-only"
        )
        source = "agents/%s.md" % agent_md.stem
        content = render_agent_toml(
            name, description, body, sandbox_mode, source=source
        )
        plan.write(OUT_AGENTS_DIR / ("%s.toml" % name), content, source=source)


def plan_agents_zcode(plan):
    """Mirror agents/*.md as ZCode subagent markdown under
    .zcode-plugin/agents/.

    ZCode reads Claude-style agent markdown, so name, description, and tools
    carry over verbatim. The model does not: ZCode accepts the Claude
    aliases but resolves every one to "no override" - the session's default
    model - which would silently flatten the tiered routing. So the mirror
    pins model and thoughtLevel from ZCODE_AGENT_MODELS; an agent missing
    from the map is generated without either and inherits the session
    default.

    Source errors are deliberately not re-reported here: plan_agents already
    failed the same file, and --write refuses to run while any error stands,
    so a second report would only duplicate the output."""
    if not AGENTS_SRC_DIR.is_dir():
        return
    for agent_md in sorted(AGENTS_SRC_DIR.glob("*.md")):
        try:
            front, body = read_frontmatter(agent_md)
        except FrontmatterError:
            continue
        name = front.get("name")
        description = front.get("description")
        if not name or not description:
            continue
        model, thought_level = ZCODE_AGENT_MODELS.get(name, ("", ""))
        source = "agents/%s.md" % agent_md.stem
        content = render_agent_zcode_md(
            name,
            description,
            body,
            front.get("tools", ""),
            model,
            thought_level,
            source=source,
        )
        plan.write(OUT_ZCODE_AGENTS_DIR / ("%s.md" % name), content, source=source)


def plan_agents_md(plan):
    header = GENERATED_MD_COMMENT.format(
        source="bin/craft-sync-codex's AGENTS_MD_BODY constant"
    )
    plan.write(
        AGENTS_MD_PATH,
        "%s\n\n%s" % (header, AGENTS_MD_BODY),
        source="bin/craft-sync-codex's AGENTS_MD_BODY constant",
    )


def build_plan():
    plan = Plan()
    plan_skills(plan)
    plan_commands(plan, existing_skill_names())
    plan_agents(plan)
    plan_agents_zcode(plan)
    plan_agents_md(plan)
    return plan


# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------


class Report:
    def __init__(self):
        self.results = []

    def add(self, group, status, check, detail=""):
        self.results.append(
            {"group": group, "status": status, "check": check, "detail": detail}
        )

    def failed(self):
        return any(result["status"] == "FAIL" for result in self.results)


def relative(path):
    try:
        return str(path.relative_to(PLUGIN_ROOT))
    except ValueError:
        return str(path)


def expected_skill_dir_names(plan):
    """Directory names under .agents/skills/ that the current plan produces."""
    names = set()
    for path in plan.files:
        if OUT_SKILLS_DIR in path.parents:
            names.add(path.relative_to(OUT_SKILLS_DIR).parts[0])
    return names


def expected_resource_dir_names(plan):
    """Map skill directory name -> the resource subdirectory names
    (references, examples, ...) the plan produces for it. A skill directory
    can hold more than one planned item -- SKILL.md plus resource copies --
    so orphan handling must also catch a resource subdirectory whose source
    was deleted while the skill itself, and its SKILL.md, still exist."""
    mapping = {}
    for _src, dst in plan.directory_copies:
        if OUT_SKILLS_DIR in dst.parents:
            skill_name = dst.relative_to(OUT_SKILLS_DIR).parts[0]
            mapping.setdefault(skill_name, set()).add(dst.name)
    return mapping


def broken_skill_or_command_names(plan):
    """Names under .agents/skills/ whose skills/ or commands/ source exists
    but failed to parse. A directory an orphan check would otherwise blame
    on a deleted source is really a parse failure, already reported under
    the 'source' group -- reporting it as an orphan too sends the developer
    to a fix ("remove it or run --write") that cannot work, since --write
    refuses to run at all while a source error stands. agents/*.md is not
    covered here: its generated file name comes from the frontmatter 'name'
    field, which may itself be the missing field, so a broken agent source
    cannot be reliably mapped back to the .toml it would have produced."""
    names = set()
    for label, _message in plan.errors:
        path = pathlib.Path(label)
        if path.name == "SKILL.md" and path.parent.parent == SKILLS_DIR:
            names.add(path.parent.name)
        elif path.suffix == ".md" and path.parent == COMMANDS_DIR:
            names.add(path.stem)
    return names


def find_skill_orphans(plan):
    """Return (whole_dir_orphans, resource_dir_orphans): paths under
    .agents/skills/ the current plan no longer produces."""
    whole = []
    resource = []
    if not OUT_SKILLS_DIR.is_dir():
        return whole, resource
    expected_dirs = expected_skill_dir_names(plan)
    broken = broken_skill_or_command_names(plan)
    resource_map = expected_resource_dir_names(plan)
    for existing in sorted(OUT_SKILLS_DIR.iterdir()):
        if not existing.is_dir():
            continue
        if existing.name not in expected_dirs:
            if existing.name not in broken:
                whole.append(existing)
            continue
        expected_children = resource_map.get(existing.name, set())
        for child in sorted(existing.iterdir()):
            if child.is_dir() and child.name not in expected_children:
                resource.append(child)
    return whole, resource


def find_agent_orphans_in(directory, pattern, plan):
    """Return generated agent files under directory the current plan no
    longer produces. A source that merely failed to parse is excluded by
    name when its 'name' field was still readable. When it was not
    (broken_agent_names cannot help), no agent orphan is reported at all
    this run -- write() already refuses to run while any source error
    stands, so no orphan advice would be actionable anyway."""
    if not directory.is_dir() or plan.has_unresolvable_broken_agent:
        return []
    planned_paths = set(plan.files.keys())
    return [
        existing
        for existing in sorted(directory.glob(pattern))
        if existing not in planned_paths
        and existing.stem not in plan.broken_agent_names
    ]


def find_agent_orphans(plan):
    """Return .toml paths under .codex/agents/ the current plan no longer
    produces."""
    return find_agent_orphans_in(OUT_AGENTS_DIR, "*.toml", plan)


def find_zcode_agent_orphans(plan):
    """Return .md paths under .zcode-plugin/agents/ the current plan no
    longer produces."""
    return find_agent_orphans_in(OUT_ZCODE_AGENTS_DIR, "*.md", plan)


def remove_path(path):
    """Remove a generated directory, including a symlinked one. shutil.rmtree
    refuses to act on a symlink and raises instead, so a symlink is unlinked."""
    if path.is_symlink():
        path.unlink()
    else:
        shutil.rmtree(path)


def check(plan):
    """Read-only: report MISSING / STALE / OK for every planned file, and
    ORPHAN for a generated file on disk that the plan no longer produces."""
    report = Report()

    for label, message in plan.errors:
        report.add("source", "FAIL", label, message)

    for path, content in sorted(plan.files.items()):
        group = "generated"
        if not path.exists():
            report.add(group, "FAIL", relative(path), "missing - run --write")
            continue
        current = path.read_text(encoding="utf-8")
        if current == content:
            report.add(group, "PASS", relative(path), "up to date")
        else:
            report.add(group, "FAIL", relative(path), "stale - run --write")

    for src, dst in plan.directory_copies:
        group = "generated"
        if not dst.is_dir():
            report.add(group, "FAIL", relative(dst), "missing - run --write")
            continue
        src_files = {p.relative_to(src) for p in src.rglob("*") if p.is_file()}
        dst_files = {p.relative_to(dst) for p in dst.rglob("*") if p.is_file()}
        if src_files != dst_files:
            report.add(group, "FAIL", relative(dst), "out of date - run --write")
            continue
        mismatched = [
            f for f in src_files if (src / f).read_bytes() != (dst / f).read_bytes()
        ]
        if mismatched:
            report.add(group, "FAIL", relative(dst), "out of date - run --write")
        else:
            report.add(group, "PASS", relative(dst), "up to date")

    whole_orphans, resource_orphans = find_skill_orphans(plan)
    for existing in whole_orphans + resource_orphans:
        report.add(
            "orphan",
            "FAIL",
            relative(existing),
            "no longer produced by the current source - remove it or run --write",
        )
    for existing in find_agent_orphans(plan) + find_zcode_agent_orphans(plan):
        report.add(
            "orphan",
            "FAIL",
            relative(existing),
            "no longer produced by the current source - remove it or run --write",
        )

    return report


def write(plan):
    report = Report()
    for label, message in plan.errors:
        report.add("source", "FAIL", label, message)
    if plan.errors:
        return report

    for path, content in sorted(plan.files.items()):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")
        report.add("generated", "PASS", relative(path), "written")

    for src, dst in plan.directory_copies:
        if dst.exists() or dst.is_symlink():
            remove_path(dst)
        shutil.copytree(src, dst)
        report.add("generated", "PASS", relative(dst), "copied from %s" % relative(src))

    whole_orphans, resource_orphans = find_skill_orphans(plan)
    for existing in resource_orphans + whole_orphans:
        remove_path(existing)
        report.add(
            "orphan", "PASS", relative(existing), "removed - no longer generated"
        )
    for existing in find_agent_orphans(plan) + find_zcode_agent_orphans(plan):
        existing.unlink()
        report.add(
            "orphan", "PASS", relative(existing), "removed - no longer generated"
        )

    return report


def print_report(report):
    order = {"FAIL": 0, "SKIP": 1, "INFO": 2, "PASS": 3}
    for result in sorted(
        report.results, key=lambda r: (r["group"], order[r["status"]])
    ):
        line = "[%s] %-9s %s" % (result["status"], result["group"], result["check"])
        if result["detail"]:
            line += " - %s" % result["detail"]
        print(line)
    counts = {}
    for result in report.results:
        counts[result["status"]] = counts.get(result["status"], 0) + 1
    print()
    print(
        "%d pass, %d fail, %d skip, %d info"
        % (
            counts.get("PASS", 0),
            counts.get("FAIL", 0),
            counts.get("SKIP", 0),
            counts.get("INFO", 0),
        )
    )


def main():
    parser = argparse.ArgumentParser(
        description="Generate the Codex CLI mirror of this plugin."
    )
    parser.add_argument(
        "--write",
        action="store_true",
        help="regenerate every Codex-side file from source",
    )
    parser.add_argument("--json", action="store_true", help="report as JSON on stdout")
    args = parser.parse_args()

    plan = build_plan()
    report = write(plan) if args.write else check(plan)

    if args.json:
        print(json.dumps(report.results, indent=2))
    else:
        print_report(report)

    return 1 if report.failed() else 0


if __name__ == "__main__":
    sys.exit(main())
