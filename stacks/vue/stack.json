{
  "id": "vue",
  "label": "Vue",
  "emoji": "💚",
  "language": "javascript",
  "priority": 80,
  "detect": {
    "any_contains": [{ "files": ["package.json"], "pattern": "\\\"vue\\\"\\s*\\s*:" }]
  },
  "source_extensions": [".vue", ".js", ".ts"],
  "tests": {
    "globs": ["*.spec.ts", "*.test.ts", "tests/*", "__tests__/*"],
    "extensions": [".vue", ".js", ".ts"],
    "id_rule": "Put the criterion ID first in the test name."
  },
  "checks": {
    "tests": [{ "when_script": "test", "run": "{pm} test" }, { "when_dependency": "vitest", "run": "npx vitest run" }, { "run": "npm test" }],
    "lint": [{ "when_script": "lint", "run": "{pm} run lint" }, { "when_dependency": "eslint", "run": "npx eslint ." }],
    "format": [{ "when_dependency": "prettier", "run": "npx prettier --check ." }],
    "types": [{ "when_dependency": "vue-tsc", "run": "npx vue-tsc --noEmit" }]
  },
  "paths": {
    "money": ["*/payment*/*", "*/billing/*", "composables/use*payment*.ts", "stores/*cart*.ts"],
    "auth": ["*/auth/*", "*auth*.ts", "*token*.ts", "stores/*auth*.ts"],
    "models": ["*/models/*", "*.model.ts"],
    "views": ["*/components/*", "*/views/*", "*/pages/*", "*.vue"]
  },
  "skills": ["component-design", "state-management", "styling-discipline"],
  "standards": ["component_design_standards", "frontend_performance_standards", "accessibility_standards"],
  "lenses": "stacks/vue/lenses.md"
}
